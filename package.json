{
  "name": "url-shortener",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "d1:migrate:local": "wrangler d1 execute url_shortener --local --file=schema.sql",
    "d1:migrate": "wrangler d1 execute url_shortener --remote --file=schema.sql"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.8",
    "wrangler": "^3.80.0"
  }
}
